<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Calculator Test Suite">

    <test name="Calculator Tests">

        <groups>
            <run>
                <include name="smoke"/>
                <include name="regression"/>
                <include name="negative"/>
            </run>
        </groups>

        <classes>
            <class name="AdditionTest"/>
            <class name="SubtractionTest"/>
            <class name="MultiplicationTest"/>
            <class name="DivisionTest"/>
        </classes>

    </test>

</suite>